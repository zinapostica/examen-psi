# --- Backend (Spring Boot) ---
PORT=8080

# Local Mongo (Docker Compose db service or local mongod)
MONGODB_URI=mongodb://localhost:27017/expense_copilot

# MongoDB Atlas free tier (M0) — replace user/password/cluster:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/expense_copilot?retryWrites=true&w=majority

STORAGE=local
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
